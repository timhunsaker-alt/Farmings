  {
   "type": "list",
   "items": [
    [
     {
      "t": "Craft "
     },
     {
      "t": "8",
      "b": true
     },
     {
      "t": " empty straws from a Wildcatter plastic sheet."
     }
    ],
    [
     {
      "t": "Use an empty straw on a tame grown bull, ram, buck, boar, stallion or turkey tom: it becomes a semen straw holding his genes."
     }
    ],
    [
     {
      "t": "Use the semen straw on a female of the same species in heat (a hen needs no heat). Any other animal refuses it."
     }
    ],
    [
     {
      "t": "Bull, ram, buck and stallion straws keep forever. Boar straws keep "
     },
     {
      "t": "6",
      "b": true
     },
     {
      "t": " days; turkey straws go stale after "
     },
     {
      "t": "30",
      "b": true
     },
     {
      "t": " real minutes."
     }
    ]
   ]
  },
